# Browser rewarded ads (Google IMA + Ad Manager VAST)
# Paste your production VAST / Ad Manager tag URL here.
VITE_IMA_AD_TAG_URL=
# When true (default if VITE_IMA_AD_TAG_URL is empty), use Google's public sample linear VAST tag.
VITE_IMA_USE_SAMPLE_TAG=true
# Force the local "Driver Campaign" modal instead of IMA (dev only).
VITE_ADS_FORCE_LOCAL=false
# Allow local modal fallback after IMA no-fill on non-localhost hosts.
VITE_ADS_ALLOW_LOCAL_FALLBACK=false

# Native Android AdMob (Capacitor)
VITE_ADMOB_ANDROID_APP_ID=ca-app-pub-0396642445880935~1557835307
VITE_ADMOB_REWARDED_UNIT_ID=ca-app-pub-0396642445880935/6253769968
VITE_ADMOB_TESTING=false
