# Wash Empire — repo .gitignore
# Design docs live at root; Unity project lives at WashEmpire/.
# Unity ignores below are scoped to the WashEmpire/ subdirectory.

# ---- Unity generated folders ----
WashEmpire/[Ll]ibrary/
WashEmpire/[Tt]emp/
WashEmpire/[Oo]bj/
WashEmpire/[Bb]uild/
WashEmpire/[Bb]uilds/
WashEmpire/[Ll]ogs/
WashEmpire/[Uu]ser[Ss]ettings/
WashEmpire/[Mm]emoryCaptures/
WashEmpire/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!WashEmpire/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# WashEmpire/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
WashEmpire/[Aa]ssets/Plugins/Editor/JetBrains*

# ---- Visual Studio / Rider / IDE ----
WashEmpire/.vs/
WashEmpire/.vsconfig
WashEmpire/.idea/
WashEmpire/.gradle/
WashEmpire/ExportedObj/
WashEmpire/.consulo/
WashEmpire/*.csproj
WashEmpire/*.unityproj
WashEmpire/*.sln
WashEmpire/*.slnx
WashEmpire/*.suo
WashEmpire/*.tmp
WashEmpire/*.user
WashEmpire/*.userprefs
WashEmpire/*.pidb
WashEmpire/*.booproj
WashEmpire/*.svd
WashEmpire/*.pdb
WashEmpire/*.mdb
WashEmpire/*.opendb
WashEmpire/*.VC.db

# Unity3D generated meta files
WashEmpire/*.pidb.meta
WashEmpire/*.pdb.meta
WashEmpire/*.mdb.meta

# Unity3D generated file on crash reports
WashEmpire/sysinfo.txt

# Builds
WashEmpire/*.apk
WashEmpire/*.aab
WashEmpire/*.unitypackage
WashEmpire/*.app

# Crashlytics generated file
WashEmpire/crashlytics-build.properties

# Packed Addressables
WashEmpire/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
WashEmpire/[Aa]ssets/[Ss]treamingAssets/aa.meta
WashEmpire/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- OS junk ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Editor backups ----
*~
*.swp
*.bak
